import 'dart:async';
import 'dart:convert';
import 'dart:io';

import 'package:crypto/crypto.dart';
import 'package:flutter/foundation.dart';
import 'package:flutter/services.dart';
import 'package:path/path.dart' as p;
import 'package:workmanager/workmanager.dart';

import '../data/db.dart';
import 'backup.dart';
import 'images.dart';
import 'settings.dart';

/// 自动备份结果
enum AutoBackupStatus { skipped, saved, failed, disabled }

class AutoBackupResult {
  final AutoBackupStatus status;
  final String? file;
  final String? error;
}

/// 写入/删除公共目录备份文件的接口（可注入，便于测试）
abstract class BackupTarget {
  /// 保存临时文件到公共目录，返回展示用的文件名/uri；失败抛异常或返回 null
  Future<String?> save(File file, String name);
  /// 删除目录里除 keepName 外的所有 gongzhuriji_ 备份
  Future<void> cleanup(String keepName);
}

class MediaStoreBackupTarget implements BackupTarget {
  static const _ch = MethodChannel('princess_diary/backup');
  @override
  Future<String?> save(File file, String name) async {
    final r = await _ch.invokeMethod<String>('saveBackup', {'path': file.path, 'name': name});
    if (r == null || r.isEmpty) return null;
    return r;
  }
  @override
  Future<void> cleanup(String keepName) async {
    await _ch.invokeMethod<int>('cleanupOld', {'keep': keepName});
  }
}
```

