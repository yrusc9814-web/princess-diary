Save with MediaStore:
```kotlin
private fun saveBackup(src: File, name: String, result: MethodChannel.Result) {
   try {
     if (Build.VERSION.SDK_INT >= 29) {
        val values = ContentValues().apply {
          put(MediaStore.MediaColumns.DISPLAY_NAME, name)
          put(MediaStore.MediaColumns.MIME_TYPE, "application/octet-stream")
          put(MediaStore.MediaColumns.RELATIVE_PATH, relDir)
          put(MediaStore.MediaColumns.IS_PENDING, 1)
        }
        val resolver = contentResolver
        val uri = resolver.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values) ?: throw IllegalStateException("无法创建文件")
        resolver.openOutputStream(uri)!!.use { out -> src.inputStream().use { it.copyTo(out) } }
        values.clear(); values.put(MediaStore.MediaColumns.IS_PENDING, 0); resolver.update(uri, values, null, null)
        // 取实际文件名（可能被加 (1)）
        val actual = queryName(uri) ?: name
        result.success(actual)
     } else { ... legacy copy, result.success(name) }
   } catch (e: Exception) { result.error("save_failed", e.message, null) }
}
```

