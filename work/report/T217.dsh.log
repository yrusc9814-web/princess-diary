```dart
class AutoBackupRunner {
  AutoBackupRunner({required this.state, required this.store, required this.exportTables, required this.images, required this.buildArchive, this.clock = DateTime.now, this.log});
  Future<AutoBackupResult> run() async {
    final now = clock();
    String? newHash;
    try {
      final tables = await exportTables();
      final imgs = await images();
      newHash = AutoBackup.fingerprint(tables, imgs);
    } catch (e) { state.lastCheckMs = ...; state.lastError=...; return failed; }
    if (newHash == state.hash && ...) { update lastCheck; return skipped; }
    ...
    final tmp = await buildArchive(name, tables);  // File
    try {
      await store.put(tempPath: tmp.path, name: name);
    } catch (e) {
      state.lastError = '$e'; state.lastCheckMs = now; return AutoBackupResult.failed;
    }
    // success: delete old
    try {
      final names = await store.listNames();
      for (final n in names) if (n != name && n.startsWith('gongzhuriji_')) await store.delete(n);
    } catch (_) {}
    state.hash = newHash; state.lastAutoMs=..., state.lastFileName=name, lastCheckMs=now, lastError='';
  }
}
```

