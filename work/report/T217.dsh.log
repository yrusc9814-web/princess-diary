private fun save(src: File, name: String, result: MethodChannel.Result) {
    if (!src.exists()) { result.error("missing", "临时文件不存在", null); return }
    if (Build.VERSION.SDK_INT >= 29) {
        try { result.success(saveToMediaStore(src, name)) } catch (e: Exception) { result.error("save_failed", e.message, null) }
    } else {
        if (checkSelfPermission(Manifest.permission.WRITE_EXTERNAL_STORAGE) != PackageManager.PERMISSION_GRANTED) {
            pending = PendingSave(src, name, result)
            requestPermissions(arrayOf(Manifest.permission.WRITE_EXTERNAL_STORAGE), REQ_WRITE)
            return
        }
        try { result.success(saveToLegacy(src, name)) } catch (e: Exception) { result.error("save_failed", e.message, null) }
    }
}
