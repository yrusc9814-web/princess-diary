    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, channelName).setMethodCallHandler { call, result ->
            when (call.method) {
                "saveBackup" -> {
                    val path = call.argument<String>("path")
                    val name = call.argument<String>("name")
                    if (path == null || name == null) { result.error("bad_args", "缺少参数", null); return@setMethodCallHandler }
                    save(File(path), name, result)
                }
                "cleanupOld" -> {
                    val keep = call.argument<String>("keep")
                    if (keep == null) { result.error("bad_args", "缺少参数", null); return@setMethodCallHandler }
                    try { result.success(cleanup(keep)) } catch (e: Exception) { result.error("cleanup_failed", e.message, null) }
                }
                "listBackups" -> {
                    try { result.success(list()) } catch (e: Exception) { result.error("list_failed", e.message, null) }
                }
                else -> result.notImplemented()
            }
        }
    }
