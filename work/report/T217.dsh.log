MediaStore insert:
```kotlin
private fun putViaMediaStore(path: String, name: String) {
  val resolver = contentResolver
  val values = ContentValues().apply {
    put(MediaStore.MediaColumns.DISPLAY_NAME, name)
    put(MediaStore.MediaColumns.MIME_TYPE, "application/octet-stream")
    put(MediaStore.MediaColumns.RELATIVE_PATH, "${Environment.DIRECTORY_DOCUMENTS}/$dirName")
    put(MediaStore.MediaColumns.IS_PENDING, 1)
  }
  val collection = MediaStore.Files.getContentUri(MediaStore.VOLUME_EXTERNAL_PRIMARY)
  val uri = resolver.insert(collection, values) ?: throw IOException("无法在 Documents/$dirName 创建文件")
  try {
    resolver.openOutputStream(uri)?.use { out -> File(path).inputStream().use { it.copyTo(out) } } ?: throw IOException(...)
    val done = ContentValues().apply { put(MediaStore.MediaColumns.IS_PENDING, 0) }
    resolver.update(uri, done, null, null)
  } catch (e: Exception) {
    runCatching { resolver.delete(uri, null, null) }
    throw e
  }
}
```

