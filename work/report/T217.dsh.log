class AutoBackupFlow {
  AutoBackupFlow({required this.readHash, required this.writeState, required this.io, this.clock});
  Future<AutoBackupOutcome> run(String fingerprint) async {
    final now = clock();
    if (fingerprint == readHash()) {
      writeState(lastCheck: now);  // keep hash/at/file
      return skipped;
    }
    final tmp = await io.exportTemp();
    final name = backupFileName(now); // gongzhuriji_yyyy-MM-dd_HHmm.wrdx
    try {
      await io.publish(tmp, name);
    } catch (e) {
      await io.discard(tmp);
      // 保留旧指纹，只更新 lastCheck? 任务说写失败不更新指纹；lastCheck 更新与否? 兜底逻辑依据 lastCheck >24h 触发；失败后应该记录 lastCheck 避免每次启动重试? 但更新 lastCheck 会让用户看不到。我选择更新 lastCheck 但记录 lastError，并且不更新指纹。
      writeState(lastCheck: now, error: '$e');
      return failed;
    }
    await io.discard(tmp);
    writeState(hash: fingerprint, at: now, file: name, lastCheck: now, error: null);
    // 删除旧文件
    final removed = await io.removeOthers(name); // 失败不应使本次备份算失败？记录但保留 fingerprint
    return saved;
  }
}
```

