```dart
Future<String> computeFingerprint() async {
  final data = await AppDb.I.exportTables();
  final sb = StringBuffer();
  // exportedAt 要剔除，否则每次都不同
  data.remove('exportedAt');
  sb.write(jsonEncode(data));  // key order deterministic: map insertion order from exportTables stable
  final dir = Directory(ImageStore.root);
  final entries = <String>[];
  if (await dir.exists()) {
    await for (final e in dir.list()) {
      if (e is File) {
        final st = await e.stat();
        entries.add('${p.basename(e.path)}|${st.size}|${st.modified.millisecondsSinceEpoch}');
      }
    }
  }
  entries.sort();
  sb.write(entries.join('\n'));
  return sha256Hex(utf8.encode(sb.toString()));
}
```

