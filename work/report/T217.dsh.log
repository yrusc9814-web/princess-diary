static Future<String> currentFingerprint() async {
  final tables = await AppDb.I.exportTables();
  final dir = Directory(ImageStore.root);
  final stamps = <ImageStamp>[];
  if (await dir.exists()) {
    await for (final f in dir.list()) {
      if (f is! File) continue;
      final st = await f.stat();
      stamps.add((name: p.basename(f.path), size: st.size, modified: st.modified.millisecondsSinceEpoch));
    }
  }
  return fingerprintFrom(tables: tables, images: stamps);
}
