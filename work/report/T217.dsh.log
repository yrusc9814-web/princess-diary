Algorithm:
```dart
static Future<AutoBackupOutcome> run({BackupSink? sink, bool force = false}) async {
  if (!Settings.autoBackupEnabled) return disabled;
  final fp = await computeFingerprint();
  final oldHash = Settings.autoBackupHash;
  final now = DateTime.now();
  if (!force && oldHash == fp) {
    Settings.autoBackupLastCheck = now.millisecondsSinceEpoch;
    return skipped;
  }
  final name = backupFileName(now);
  File? tmp;
  try {
    tmp = await Backup.exportNamed(name);  // writes to temp
    final s = sink ?? MediaStoreSink();
    final uri = await s.save(tmp.path, name);
    // delete old
    final names = await s.list();
    for (final n in names) {
      if (n != name) await s.delete(n);
    }
    Settings.autoBackupHash = fp;
    Settings.autoBackupAt = now...;
    Settings.autoBackupFile = name;
    Settings.autoBackupLastCheck = now...;
    return saved
  } catch (e) {
    return failed;
  } finally { delete tmp }
}
```

