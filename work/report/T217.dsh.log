  static Future<AutoBackupResult> run({DateTime? now, BackupTarget? target, bool ensureOpen = false}) async {
    if (!Settings.autoBackupEnabled) return disabled;
    if (_running) return ... // busy? 
    _running = true;
    try {
      if (ensureOpen) { await Settings.init(); await ImageStore.init(); await AppDb.I.open(); }
      final fp = await fingerprint();
      final t = now ?? DateTime.now();
      final prevHash = Settings.autoBackupHash;
      if (prevHash.isNotEmpty && prevHash == fp) {
        Settings.autoBackupLastCheck = t.millisecondsSinceEpoch;
        Settings.autoBackupSkipped = true;
        return AutoBackupResult(skipped);
      }
      final name = Backup.fileName(t);
      File? tmp;
      String? saved;
      try {
        tmp = await Backup.export(at: t);
        saved = await (target ?? AutoBackup.target).save(tmp, name);
        if (saved == null) throw const FileSystemException('保存到公共目录失败');
      } catch (e) {
        // 写失败：保留旧文件，不更新指纹
        Settings.autoBackupLastCheck = t.millisecondsSinceEpoch;
        return failed(e);
      } finally { try { await tmp?.delete(); } catch (_) {} }
      // 新文件写成功，再删旧
      try { await (target ?? ...).cleanup(name); } catch (_) {}
      Settings.autoBackupHash = fp;
      Settings.autoBackupAt = t.ms;
      Settings.autoBackupFile = name;
      Settings.autoBackupLastCheck = t.ms;
      Settings.autoBackupSkipped = false;
      return saved;
    } finally { _running = false; }
  }
