Fingerprint:
```dart
static Future<String> computeFingerprint() async {
  final tables = await AppDb.I.exportTables();
  final map = Map<String, Object>.from(tables)..remove('exportedAt');
  final dataJson = _canonicalJson(map);
  final images = await imageFingerprints();
  return fingerprintOf(dataJson, images);
}

static String fingerprintOf(String dataJson, List<ImageEntry> images) {
  final b = StringBuffer()..write(dataJson);
  for (final e in images) { b.write('\n${e.name}\t${e.size}\t${e.modifiedMs}'); }
  return sha256.convert(utf8.encode(b.toString())).toString();
}
```
