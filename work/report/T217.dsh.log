Implement helper functions:

```kotlin
private fun targetFileName(name: String) = name

private fun legacyDir(): File = File(Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DOCUMENTS), "公主日记备份")

private fun publishFile(src: File, name: String) {
  if (Build.VERSION.SDK_INT >= 29) {
    val resolver = contentResolver
    val collection = MediaStore.Files.getContentUri(MediaStore.VOLUME_EXTERNAL_PRIMARY)
    // delete existing same name first
    deleteInMediaStore(name, onlySameName = true)
    val values = ContentValues().apply {
      put(MediaStore.MediaColumns.DISPLAY_NAME, name)
      put(MediaStore.MediaColumns.MIME_TYPE, "application/octet-stream")
      put(MediaStore.MediaColumns.RELATIVE_PATH, relDir)
      put(MediaStore.MediaColumns.IS_PENDING, 1)
    }
    val uri = resolver.insert(collection, values) ?: throw IllegalStateException("无法创建备份文件")
    try {
      resolver.openOutputStream(uri)?.use { out -> src.inputStream().use { it.copyTo(out) } } ?: throw IllegalStateException(...)
      val done = ContentValues().apply { put(MediaStore.MediaColumns.IS_PENDING, 0) }
      resolver.update(uri, done, null, null)
    } catch (e: Exception) { resolver.delete(uri, null, null); throw e }
  } else {
    val dir = legacyDir(); dir.mkdirs()
    val dst = File(dir, name)
    src.inputStream().use { input -> FileOutputStream(dst).use { input.copyTo(it) } }
  }
}
```

Note: MediaStore.Files.getContentUri(VOLUME_EXTERNAL_PRIMARY) requires API 29 constant VOLUME_EXTERNAL_PRIMARY — available API 29. Guard.

