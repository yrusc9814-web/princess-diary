```dart
class AutoBackupRunner {
  AutoBackupRunner({required this.store, required this.target, required this.fingerprint, required this.buildPackage, this.now = DateTime.now});
  final AutoBackupStore store;
  final BackupTarget target;
  final Future<String> Function() fingerprint;
  final Future<File> Function() buildPackage;
  final DateTime Function() now;

  Future<AutoBackupOutcome> run() async {
    await store.load();
    final stamp = now();
    String fp;
    try { fp = await fingerprint(); } catch (e) {
      store.lastError = '$e'; await store.save();
      return AutoBackupOutcome.failed('计算数据指纹失败：$e');
    }
    if (store.hash.isNotEmpty && fp == store.hash) {
      store.lastCheck = stamp.millisecondsSinceEpoch;
      store.lastError = '';
      await store.save();
      return AutoBackupOutcome.skipped();
    }
    File? pkg;
    try {
      pkg = await buildPackage();
    } catch (e) { ... }
    final name = backupFileName(stamp);
    try {
      await target.store(pkg, name);
    } catch (e) {
      try { await pkg.delete(); } catch (_) {}
      store.lastError = ...; store.lastCheck = ...; await store.save();
      return AutoBackupOutcome.failed(...);
    }
    try { await target.removeOthers(name); } catch (e) { /* 旧文件删不掉不影响本次备份 */ }
    store.hash = fp; store.lastAt = ...; store.file = name; store.lastCheck = ...; store.lastError = '';
    await store.save();
    return AutoBackupOutcome.written(name);
  }
}
```

