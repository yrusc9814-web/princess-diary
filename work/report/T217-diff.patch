diff --git a/source/wardrobe-android/android/app/src/main/kotlin/com/mywardrobe/my_wardrobe/MainActivity.kt b/source/wardrobe-android/android/app/src/main/kotlin/com/mywardrobe/my_wardrobe/MainActivity.kt
